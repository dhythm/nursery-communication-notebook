APP_ENV=development
AUTH_MODE=skip
# 本番は AUTH_MODE=clerk とし、Clerk Dashboardの値を設定します。
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://nursery:nursery_local@127.0.0.1:54329/nursery
PGLITE_DATA_DIR=.data/pglite
FILE_STORAGE_DIR=.data/files
FILE_STORAGE_PROVIDER=local
# 本番は FILE_STORAGE_PROVIDER=s3 とし、非公開バケットを設定します。
# S3_BUCKET=
# S3_REGION=ap-northeast-1
# S3_ENDPOINT=
# 初回の園管理者を `pnpm db:bootstrap` で登録する場合に指定します。
# BOOTSTRAP_FACILITY_SLUG=
# BOOTSTRAP_FACILITY_NAME=
# BOOTSTRAP_MANAGER_NAME=
# BOOTSTRAP_MANAGER_EMAIL=
