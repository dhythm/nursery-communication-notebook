{
  "name": "nursery-communication-notebook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test",
    "check:all": "pnpm check && pnpm test:e2e && pnpm build:agent",
    "dev:agent": "node --import tsx scripts/environment.ts agent dev",
    "build:agent": "node --import tsx scripts/environment.ts agent build",
    "start:agent": "node --import tsx scripts/environment.ts agent start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "node --import tsx scripts/environment.ts configured setup",
    "db:bootstrap": "node --import tsx scripts/bootstrap-facility.ts",
    "db:check": "node --import tsx scripts/environment.ts configured check",
    "db:setup:agent": "node --import tsx scripts/environment.ts agent setup",
    "db:check:agent": "node --import tsx scripts/environment.ts agent check",
    "db:setup:local": "node --import tsx scripts/environment.ts local setup",
    "auth:set-password": "node --import tsx scripts/set-password.ts",
    "data:backup": "node --import tsx scripts/data-maintenance.ts backup",
    "data:restore": "node --import tsx scripts/data-maintenance.ts restore",
    "data:retention": "node --import tsx scripts/data-maintenance.ts retention"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@base-ui/react": "^1.5.0",
    "@clerk/nextjs": "^7.9.2",
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "^16.3.5",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.35.1",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
